+{
+ "align_labels_right": 0,
+ "creation": "2026-11-25 12:00:00.000000",
+ "custom_format": 1,
+ "disabled": 0,
+ "doc_type": "Material Request",
+ "docstatus": 0,
+ "doctype": "Print Format",
+ "font_size": 0,
+ "html": "{%- macro tick(v) -%}<span class=\"fa-box\">{% if v %}&#10003;{% endif %}</span>{%- endmacro -%}\n{%- macro who(user) -%}{% if user %}{{ frappe.db.get_value(\"User\", user, \"full_name\") or user }}{% endif %}{%- endmacro -%}\n{%- macro when(v) -%}{% if v %}{{ frappe.format(v, {\"fieldtype\": \"Datetime\"}) }}{% endif %}{%- endmacro -%}\n<style>\n.fa { font-size: 11.5px; color: #000; }\n.fa table { width: 100%; border-collapse: collapse; }\n.fa td, .fa th { border: 1px solid #000; padding: 4px 6px; vertical-align: top; }\n.fa th { background: #eee; text-align: left; }\n.fa .head td { border: none; padding: 2px 0; }\n.fa .title { font-size: 15px; font-weight: bold; text-align: center; }\n.fa .code { text-align: right; font-weight: bold; }\n.fa .lbl { font-weight: bold; white-space: nowrap; }\n.fa .fa-box { display: inline-block; width: 11px; height: 11px; border: 1px solid #000; text-align: center; line-height: 10px; font-size: 10px; margin-right: 4px; }\n.fa .num { text-align: right; }\n.fa .gap { height: 10px; }\n.fa .ctrl td { font-size: 9.5px; }\n</style>\n<div class=\"fa\">\n<table class=\"head\">\n  <tr><td style=\"width:33%\"></td><td class=\"title\">Fertilizer Advice</td><td class=\"code\">MOLFM27</td></tr>\n  <tr><td colspan=\"3\" class=\"code\" style=\"font-weight:normal\">{{ doc.name }}</td></tr>\n</table>\n<div class=\"gap\"></div>\n<table>\n  <tr>\n    <td><span class=\"lbl\">Farm Name:</span> {{ doc.production_fa_farm or \"\" }}</td>\n    <td colspan=\"2\"><span class=\"lbl\">Location:</span> {{ doc.production_fa_location or \"\" }}</td>\n  </tr>\n  <tr>\n    <td><span class=\"lbl\">App Week No:</span> {{ doc.production_fa_app_week or \"\" }}</td>\n    <td><span class=\"lbl\">Advice Date:</span> {{ frappe.format(doc.transaction_date, {\"fieldtype\": \"Date\"}) }}</td>\n    <td><span class=\"lbl\">Operator Name:</span> {{ doc.production_fa_operator_name or \"\" }}</td>\n  </tr>\n  <tr>\n    <td><span class=\"lbl\">Block Name:</span> {{ doc.production_fa_block or \"\" }}</td>\n    <td><span class=\"lbl\">Area (ha):</span> {{ frappe.format(doc.production_fa_area_ha, {\"fieldtype\": \"Float\", \"precision\": 2}) }}</td>\n    <td><span class=\"lbl\">Crop:</span> {{ doc.production_fa_crop or \"\" }} &nbsp; <span class=\"lbl\">Crop Stage:</span> {{ doc.production_fa_crop_stage or \"\" }}</td>\n  </tr>\n</table>\n<div class=\"gap\"></div>\n<table>\n  <tr><th style=\"width:33%\">Equipment/ Machinery Used: (Tick as appropriate)</th><th style=\"width:34%\">Method of Application: (Tick as appropriate)</th><th>Type of Application: (Tick as appropriate)</th></tr>\n  <tr>\n    <td>\n      {{ tick(doc.production_fa_eq_graduated_container) }}Graduated container<br>\n      {{ tick(doc.production_fa_eq_knapsack) }}Knapsack<br>\n      {{ tick(doc.production_fa_eq_injector_pump) }}Injector Pump<br>\n      {{ tick(doc.production_fa_eq_others) }}Others: {{ doc.production_fa_eq_others_detail or \"\" }}\n    </td>\n    <td>\n      {{ tick(doc.production_fa_m_broadcasting) }}Broadcasting<br>\n      {{ tick(doc.production_fa_m_drilling) }}Drilling<br>\n      {{ tick(doc.production_fa_m_foliar) }}Spraying (foliar)<br>\n      {{ tick(doc.production_fa_m_fertigation) }}Fertigation<br>\n      {{ tick(doc.production_fa_m_banding) }}Banding\n    </td>\n    <td>\n      {{ tick(doc.production_fa_t_base_dressing) }}Base dressing<br>\n      {{ tick(doc.production_fa_t_top_dressing) }}Top dressing<br>\n      {{ tick(doc.production_fa_t_marking) }}Marking\n    </td>\n  </tr>\n</table>\n<div class=\"gap\"></div>\n<table>\n  <tr><th>Fertilizer Type</th><th>Fertilizer Composition</th><th class=\"num\">Total Fertilizer Qty</th><th class=\"num\">Application Rate (Qty/ha)</th></tr>\n  {%- for row in doc.items %}\n  <tr>\n    <td>{{ row.item_name or row.item_code }}</td>\n    <td>{{ row.production_fertilizer_composition or \"\" }}</td>\n    <td class=\"num\">{{ frappe.format(row.qty, {\"fieldtype\": \"Float\"}) }} {{ row.uom }}</td>\n    <td class=\"num\">{{ frappe.format(row.production_rate_per_ha, {\"fieldtype\": \"Float\", \"precision\": 3}) }} {{ row.uom }}/ha</td>\n  </tr>\n  {%- endfor %}\n</table>\n<div class=\"gap\"></div>\n<table>\n  <tr><td class=\"lbl\" style=\"width:30%\">Actual Date of Application:</td><td colspan=\"2\">{% if doc.production_fa_application_date %}{{ frappe.format(doc.production_fa_application_date, {\"fieldtype\": \"Date\"}) }}{% endif %}</td></tr>\n  <tr><td class=\"lbl\">Prepared by:</td><td>{{ who(doc.production_fa_prepared_by) }}</td><td style=\"width:30%\">Date: {{ when(doc.production_fa_prepared_on) }}</td></tr>\n  <tr><td class=\"lbl\">Technical Authorization by:</td><td>{{ who(doc.production_fa_authorized_by) }}</td><td>Date: {{ when(doc.production_fa_authorized_on) }}</td></tr>\n  <tr><td class=\"lbl\">Issued by (Stores person):</td><td>{{ who(doc.production_fa_issued_by) }}</td><td>Date: {{ when(doc.production_fa_issued_on) }}</td></tr>\n  <tr><td class=\"lbl\">Collected by (Supervisor):</td><td>{{ who(doc.production_fa_collected_by) }}</td><td>Date: {{ when(doc.production_fa_collected_on) }}</td></tr>\n</table>\n<p style=\"font-size:9.5px;margin:4px 0 0\">Sign-offs are recorded electronically in ERPNext with the user and time of each step.</p>\n<div class=\"gap\"></div>\n<table class=\"ctrl\">\n  <tr><td colspan=\"3\"><b>MUTARA ORCHARDS LIMITED</b></td><td colspan=\"5\"><b>Field Food Safety and Quality Manual</b></td><td colspan=\"3\"><b>Effective Date: 16th March 2026</b></td></tr>\n  <tr><th>Document No.</th><th>Issue No.</th><th>Revision No.</th><th>Revision Date</th><th>Issue Date</th><th>Supersedes</th><th>Reason for review</th><th>Page</th><th>Prepared by</th><th colspan=\"2\">Approved by</th></tr>\n  <tr><td>Field/FSQM/2</td><td>002</td><td>001</td><td>March 11th, 2026</td><td>March 12th, 2026</td><td>Previous</td><td>New Changes</td><td>1 of 1</td><td>Compliance Manager</td><td colspan=\"2\">General Manager</td></tr>\n</table>\n</div>\n",
